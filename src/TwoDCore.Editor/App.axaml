<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="TwoDCore.Editor.App"
             RequestedThemeVariant="Dark">
  <Application.Styles>
    <FluentTheme />
    <Style Selector="Window">
      <Setter Property="Background" Value="#121317" />
      <Setter Property="FontFamily" Value="Segoe UI,avares://Avalonia.Fonts.Inter/Assets#Inter" />
      <Setter Property="FontSize" Value="13" />
    </Style>
    <Style Selector="Border.editor-panel">
      <Setter Property="Background" Value="#18191E" />
      <Setter Property="BorderThickness" Value="0" />
    </Style>
    <Style Selector="Border.panel-header">
      <Setter Property="Background" Value="#202128" />
    </Style>
    <Style Selector="TextBlock.panel-title">
      <Setter Property="FontWeight" Value="Bold" />
      <Setter Property="FontSize" Value="11" />
      <Setter Property="Foreground" Value="#AAAFBE" />
      <Setter Property="Margin" Value="10,0" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="Button.node-add">
      <Setter Property="Opacity" Value="0" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="Margin" Value="1" />
      <Setter Property="MinWidth" Value="18" />
      <Setter Property="MinHeight" Value="18" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="FontSize" Value="17" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <Style Selector="TreeViewItem:pointerover Button.node-add">
      <Setter Property="Opacity" Value="1" />
    </Style>
    <Style Selector="TreeViewItem">
      <Setter Property="MinHeight" Value="24" />
      <Setter Property="Padding" Value="2,0" />
      <Setter Property="Margin" Value="0" />
    </Style>
    <Style Selector="TreeViewItem:selected /template/ Border#PART_LayoutRoot">
      <Setter Property="Background" Value="#3478F6" />
    </Style>
    <Style Selector="Button.header-action, Button.header-close">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Padding" Value="2" />
      <Setter Property="FontSize" Value="11" />
      <Setter Property="Foreground" Value="#B4B4BE" />
    </Style>
    <Style Selector="Button.header-close:pointerover">
      <Setter Property="Background" Value="#E81123" />
      <Setter Property="Foreground" Value="White" />
    </Style>
  </Application.Styles>
</Application>
