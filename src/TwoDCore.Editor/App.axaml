<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="TwoDCore.Editor.App"
             RequestedThemeVariant="Dark">
  <Application.Styles>
    <FluentTheme />
    <Style Selector="Window">
      <Setter Property="Background" Value="#121317" />
      <Setter Property="FontFamily" Value="avares://Avalonia.Fonts.Inter/Assets#Inter" />
    </Style>
    <Style Selector="Border.panel">
      <Setter Property="Background" Value="#18191E" />
      <Setter Property="BorderBrush" Value="#2B2D35" />
      <Setter Property="BorderThickness" Value="1" />
    </Style>
    <Style Selector="TextBlock.panel-title">
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Foreground" Value="#BEC3D2" />
      <Setter Property="Margin" Value="10,7" />
    </Style>
    <Style Selector="Button.toolbar">
      <Setter Property="Margin" Value="3,2" />
      <Setter Property="Padding" Value="10,5" />
    </Style>
  </Application.Styles>
</Application>
